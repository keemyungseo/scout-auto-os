# Scout Live V1 — copy to .env (NEVER commit .env)

# === REQUIRED (MODE=LIVE) ===
BINANCE_API_KEY=
BINANCE_API_SECRET=

# === TRADING ===
TRADE_SIZE=7
LEVERAGE=3
MODE=LIVE

# === REPORT (KST hour) ===
REPORT_TIME=08:00

# === OPTIONAL alerts ===
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# === RESEARCH ENGINE (no orders) ===
RESEARCH_ENABLED=true
RESEARCH_SCAN_INTERVAL_MIN=5
RESEARCH_TOP_N=20

# === V1.3 Entry Quality Guard ===
MIN_24H_QUOTE_VOLUME_USDT=10000000
MIN_1H_QUOTE_VOLUME_USDT=400000
MIN_5M_QUOTE_VOLUME_RATIO=1.5
MAX_PULLBACK_FROM_15M_HIGH_PCT=2.5
BLOCK_LAST_5M_RED_CANDLE=true
MAX_ESTIMATED_SLIPPAGE_PCT=0.3
BLOCK_NEGATIVE_EV=true

# === V1.3 Emergency Risk Guard ===
MAX_POSITION_ROI_LOSS_PCT=-18
MAX_POSITION_UNREALIZED_LOSS_USDT=-0.60
MAX_HOLD_MINUTES_WITH_NEGATIVE_PNL=45

# === V1.4 State Engine ===
STATE_REVIEW_INTERVAL_SEC=1800
STATE_HOLD_TARGET_MINUTES=120
STATE_MIN_HOLD_MINUTES=30
STATE_HOLD_ALIVE_SCORE=70
STATE_EXIT_ALIVE_SCORE=45
STATE_ALIVE_DELTA_EXIT=-25
STATE_PROTECTIVE_SL_PCT=10
