# Scout Live V1 — copy to .env (NEVER commit .env)

# === REQUIRED (MODE=LIVE) ===
BINANCE_API_KEY=
BINANCE_API_SECRET=

# === TRADING ===
TRADE_SIZE=7
LEVERAGE=3
MODE=LIVE

# === REPORT (KST hour) ===
REPORT_TIME=08:00

# === OPTIONAL alerts ===
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# === RESEARCH ENGINE (no orders) ===
RESEARCH_ENABLED=false
RESEARCH_SCAN_INTERVAL_MIN=5
RESEARCH_TOP_N=20
